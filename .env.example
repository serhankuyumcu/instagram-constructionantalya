# ---------------------------------------------------------------------------
# Instagram Graph API
# Kurulum adimlari icin README.md > "Instagram token alma" bolumune bak.
# ---------------------------------------------------------------------------

# Instagram Business hesabinin sayisal ID'si (17 haneli)
IG_USER_ID=

# Erisim tokeni.
# Normal "uzun omurlu" token 60 gunde bir yenilenmek zorundadir.
# README'deki System User yontemiyle SURESIZ token almani oneririm; aksi halde
# iki ayda bir bot sessizce durur.
IG_ACCESS_TOKEN=

# Graph API surumu. Meta her surumu ~2 yil destekler; hata alirsan
# developers.facebook.com/docs/graph-api/changelog uzerinden guncel surume cek.
GRAPH_API_VERSION=v21.0

# ---------------------------------------------------------------------------
# Caption uretimi (Claude API)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Icerik kaynagi
# ---------------------------------------------------------------------------
SITE_BASE_URL=https://constructionantalya.com

# Caption dili: tr | en | ru
# Antalya lüks insaat pazarinda "en" genelde daha genis kitleye ulasir.
CAPTION_LOCALE=en

# ---------------------------------------------------------------------------
# Gorsel barindirma
# Instagram gorseli PUBLIC bir URL'den ceker, dosya yuklemesi kabul etmez.
# host=github  -> uretilen gorsel repo'nun media branch'ine push edilir (repo public olmali)
# host=cloudinary -> private repo icin; asagidaki Cloudinary degiskenlerini doldur
# ---------------------------------------------------------------------------
IMAGE_HOST=github

# host=github icin (GitHub Actions bunlari otomatik doldurur)
GITHUB_REPOSITORY=
GITHUB_TOKEN=
MEDIA_BRANCH=media

# host=cloudinary icin
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
